# Copy these into Vercel -> Project "truckle" -> Settings -> Environment Variables
# (tick Production, Preview and Development). Never commit real values.

# Supabase: Project Settings -> API (or "Connect")
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=            # the "anon" / "publishable" key (public, safe in the browser)
SUPABASE_SERVICE_ROLE_KEY=    # the "service_role" / "secret" key (server only; mark Sensitive)

# Stripe sandbox "Truckle": Developers -> API keys (must start with pk_test_ / sk_test_)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...          # mark Sensitive
# Stripe -> Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...        # mark Sensitive
# Optional: a second endpoint just for connected-account events
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# Optional: fixed public URL used for Stripe return links (defaults to the request host)
# APP_URL=https://truckle.vercel.app
# Live keys are refused unless this is set to 1
# TRUCKLE_ALLOW_LIVE=0
